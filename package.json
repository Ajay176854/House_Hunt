{
  "name": "househunt",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "next dev",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "build:api": "esbuild server/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:web": "next build",
    "build": "npm run build:web && npm run build:api",
    "start:api": "node dist/server.cjs",
    "start:web": "next start",
    "start": "concurrently \"npm run start:api\" \"npm run start:web\"",
    "lint": "next lint && tsc --noEmit",
    "clean": "rm -rf dist .next"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.4",
    "concurrently": "^9.1.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.546.0",
    "morgan": "^1.10.0",
    "motion": "^12.23.24",
    "next": "^15.3.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.14.0",
    "@types/react": "19.2.18",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
